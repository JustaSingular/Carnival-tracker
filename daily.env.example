# Copy to daily.env and fill in. Keep daily.env out of version control.

# The push app. Uploads silently — no notification is sent unless daily.js is
# run with --notify. Every day stays browsable at /shot.html, latest by default,
# so one bookmark on the phone always shows today's image. Long-press to save.
PUSH_BASE_URL=https://YOUR-SITE.netlify.app
PUSH_TOKEN=the PUSH_TOKEN from push-notif-app

# Optional second copy into any local or synced folder. Leave unset to skip.
# SAVE_DIR=C:\Users\Peter\Pictures\Carnival

# Only for testing Instagram from this machine — the daily post reads these from
# GitHub secrets, not from here. `node instagram.js whoami` prints the user id.
# IG_ACCESS_TOKEN=
# IG_USER_ID=
